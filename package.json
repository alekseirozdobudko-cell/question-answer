{
  "name": "question-and-answer",
  "version": "1.0.1",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --lan",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.cjs",
    "export:web": "expo export --platform web && node scripts/build-standalone.cjs",
    "export:android": "expo export --platform android --output-dir android-dist"
  },
  "dependencies": {
    "expo": "~58.0.23",
    "expo-audio": "~58.0.11",
    "expo-file-system": "~58.0.13",
    "expo-keep-awake": "~58.0.3",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
