{
  "expo": {
    "name": "Question and Answer",
    "slug": "question-and-answer",
    "version": "1.0.2",
    "icon": "./assets/app-icon/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "platforms": [
      "android",
      "ios",
      "web"
    ],
    "android": {
      "package": "com.alex.questionanswer",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon/adaptive-icon.png",
        "monochromeImage": "./assets/app-icon/monochrome-icon.png",
        "backgroundColor": "#232B27"
      }
    },
    "web": {
      "bundler": "metro",
      "name": "Question and Answer",
      "shortName": "Q&A",
      "favicon": "./assets/app-icon/icon.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-status-bar"
    ]
  }
}
